:root {
  --bg-deep: #05070c;
  --text-white: #f8fafc;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  
  --accent-cyan: #38bdf8;
  --accent-indigo: #6366f1;
  --accent-emerald: #10b981;
  
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-display: 'Space Grotesk', sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-deep);
  color: var(--text-white);
  font-family: var(--font-sans);
  line-height: 1.6;
  overflow-x: hidden;
  min-height: 100vh;
}

.app-layout {
  position: relative;
  z-index: 2;
  max-width: 1280px;
  margin: 0 auto;
  padding: 48px 24px;
}

/* Header Section */
.hero-card {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 40px;
  padding: 48px;
  margin-bottom: 32px;
  align-items: center;
}

.portrait-container {
  width: 210px;
  height: 210px;
  border-radius: 20px;
  padding: 5px;
  background: linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.02));
  box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  margin: 0 auto;
}

.portrait-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 16px;
}

.hero-name {
  font-family: var(--font-display);
  font-size: 3.2rem;
  font-weight: 700;
  letter-spacing: -1.5px;
  line-height: 1.1;
  margin-bottom: 8px;
  background: linear-gradient(135deg, #ffffff 40%, var(--text-muted));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--accent-cyan);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 20px;
}

.contact-pill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 20px;
}

.contact-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.04);
  padding: 6px 14px;
  border-radius: 30px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.88rem;
  color: var(--text-muted);
}

.contact-pill svg {
  width: 14px;
  height: 14px;
  fill: var(--accent-cyan);
}

.hero-summary {
  color: var(--text-muted);
  font-size: 1.05rem;
  line-height: 1.7;
}

/* Metrics Row */
.metrics-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 36px;
}

.metric-box {
  padding: 24px;
  text-align: center;
}

.metric-number {
  font-family: var(--font-display);
  font-size: 2.4rem;
  font-weight: 700;
  margin-bottom: 4px;
}

.metric-number.accent-text {
  background: linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.metric-tag {
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-dim);
  font-weight: 700;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.filter-tab {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-muted);
  padding: 10px 22px;
  border-radius: 30px;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.filter-tab:hover, .filter-tab.active {
  color: var(--text-white);
  border-color: var(--accent-cyan);
  background: rgba(56, 189, 248, 0.15);
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
}

/* Main Grid Layout */
.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 24px;
  margin-bottom: 48px;
}

.record-card {
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  cursor: pointer;
}

.card-top {
  margin-bottom: 16px;
}

.card-badge {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  padding: 4px 10px;
  border-radius: 20px;
  background: rgba(56, 189, 248, 0.1);
  color: var(--accent-cyan);
  border: 1px solid rgba(56, 189, 248, 0.2);
  display: inline-block;
  margin-bottom: 12px;
}

.card-badge.emerald {
  background: rgba(16, 185, 129, 0.1);
  color: var(--accent-emerald);
  border-color: rgba(16, 185, 129, 0.2);
}

.card-badge.indigo {
  background: rgba(99, 102, 241, 0.1);
  color: var(--accent-indigo);
  border-color: rgba(99, 102, 241, 0.2);
}

.card-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-white);
  line-height: 1.35;
  margin-bottom: 6px;
}

.card-org {
  font-size: 0.9rem;
  color: var(--text-muted);
  font-weight: 500;
  margin-bottom: 14px;
}

.card-description {
  color: var(--text-muted);
  font-size: 0.93rem;
  line-height: 1.6;
}

.card-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 16px;
  margin-top: 20px;
  display: flex;
  justify-content: space-between;
  font-size: 0.82rem;
  color: var(--text-dim);
  font-weight: 600;
}

/* Section Common Styling */
.section-padding {
  padding: 40px;
  margin-bottom: 40px;
}

.section-heading {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 24px;
  letter-spacing: -0.5px;
}

/* Skills Cloud */
.skills-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.skill-tag {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 8px 16px;
  border-radius: 12px;
  font-size: 0.88rem;
  color: var(--text-white);
  transition: all 0.25s ease;
}

.skill-tag:hover {
  border-color: var(--accent-cyan);
  background: rgba(56, 189, 248, 0.1);
  transform: translateY(-2px);
}

/* Seminar List */
.seminar-grid {
  display: grid;
  gap: 12px;
}

.seminar-card {
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.seminar-title {
  font-size: 0.98rem;
  font-weight: 600;
  color: var(--text-white);
  margin-bottom: 4px;
}

.seminar-speaker {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* Modal Styling */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(15px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal-backdrop.active {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  width: 100%;
  max-width: 650px;
  padding: 40px;
  position: relative;
}

.modal-close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-white);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1.2rem;
}

@media (max-width: 900px) {
  .hero-card { grid-template-columns: 1fr; text-align: center; }
  .contact-pill-grid { justify-content: center; }
  .grid-container { grid-template-columns: 1fr; }
}